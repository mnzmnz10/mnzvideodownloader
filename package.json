{
  "name": "mnzvideodownloader",
  "productName": "MNZ Video Downloader",
  "version": "1.2.0",
  "description": "YouTube, Instagram, X (Twitter), TikTok ve yüzlerce siteden MP4 video / MP3 ses indirici",
  "main": "src/main.js",
  "author": "mnzmnz10",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.mnz.videodownloader",
    "productName": "MNZ Video Downloader",
    "artifactName": "mnzvideodownloader-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MNZ Video Downloader",
      "artifactName": "mnzvideodownloader-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "mnzvideodownloader-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mnzmnz10",
        "repo": "mnzvideodownloader",
        "releaseType": "release"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mnzmnz10/mnzvideodownloader.git"
  }
}
